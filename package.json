{
  "name": "vaultpress",
  "version": "0.1.0",
  "type": "module",
  "description": "Publish a collaborative AFFiNE workspace with Next.js and Fumadocs",
  "license": "MIT",
  "author": "Qiyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyangdev/vaultpress.git"
  },
  "bugs": {
    "url": "https://github.com/qiyangdev/vaultpress/issues"
  },
  "homepage": "https://github.com/qiyangdev/vaultpress#readme",
  "keywords": [
    "affine",
    "fumadocs",
    "nextjs",
    "documentation",
    "markdown",
    "mdx",
    "wiki",
    "knowledge-graph"
  ],
  "scripts": {
    "build": "node scripts/stage.ts && fumadocs-mdx && next build",
    "dev": "node scripts/dev.ts",
    "start": "next start",
    "test": "vitest run",
    "types:check": "rm -rf .source .next/types .next/dev/types && node scripts/stage.ts && fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint",
    "stage": "node scripts/stage.ts",
    "build:all": "node scripts/build-all.ts",
    "locales:migrate": "node scripts/migrate-to-locales.ts",
    "locales:report": "node scripts/locales-report.ts",
    "generate": "pnpm generate:affine",
    "generate:affine": "node --env-file=.env.affine scripts/generate-affine.ts",
    "generate:affine:all": "node --env-file=.env.publisher scripts/generate-affine-all.ts",
    "publisher:sync-locales": "node --env-file=.env.publisher scripts/run-affine-authoring.ts scripts/sync-affine-locales.ts",
    "publisher:sync-site": "node --env-file=.env.publisher scripts/run-affine-authoring.ts scripts/sync-affine-site.ts",
    "publisher:seed-media": "node --env-file=.env.publisher scripts/run-affine-authoring.ts scripts/seed-affine-media.ts",
    "publisher:seed-book-covers": "node --env-file=.env.publisher scripts/run-affine-authoring.ts scripts/seed-affine-book-covers.ts",
    "publisher:watch": "node --env-file=.env.publisher scripts/affine-publisher-service.ts",
    "publisher:doctor": "node --env-file=.env.publisher scripts/publisher-doctor.ts",
    "publisher:release": "node --env-file=.env.publisher scripts/publisher-release.ts",
    "publisher:rollback": "node --env-file=.env.publisher scripts/publisher-rollback.ts",
    "publisher:deploy": "node --env-file=.env.publisher scripts/publisher-deploy.ts",
    "publisher:service:install": "node scripts/install-affine-publisher-service.ts",
    "migrate:affine-metadata": "node --env-file=.env.publisher scripts/run-affine-authoring.ts scripts/migrate-affine-metadata.ts",
    "prepare:affine-import": "node scripts/prepare-affine-import.ts",
    "stage:affine": "node scripts/stage.ts",
    "stage:obsidian": "CONTENT_SOURCE=obsidian node scripts/stage.ts"
  },
  "dependencies": {
    "@affine-fumadocs/publisher": "github:zubayrali/affine-fumadocs-publisher#6b6d45f47c578ec2b51ee6121b3dbc17161c6917",
    "@floating-ui/dom": "^1.7.6",
    "@types/lz-string": "^1.5.0",
    "@xyflow/react": "^12.11.0",
    "beautiful-mermaid": "^1.1.3",
    "d3-force": "^3.0.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-obsidian": "^0.1.0",
    "fumadocs-ui": "16.9.3",
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.2.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "lz-string": "^1.5.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "perfect-freehand": "^1.2.3",
    "punycode": "^2.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@inkjs/ui": "^2.0.0",
    "@keystatic/core": "0.5.51",
    "@keystatic/next": "5.0.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "ink": "^7.0.5",
    "mdast-util-mdx-jsx": "^3.2.0",
    "oxlint": "^1.68.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.8"
  }
}
