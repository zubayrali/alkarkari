# AFFiNE's workspace-scoped, read-only MCP endpoint.
AFFINE_MCP_URL=http://localhost:3010/api/workspaces/WORKSPACE_ID/mcp
AFFINE_MCP_TOKEN=

# Seed discovery with a manifest page and/or an explicit comma-separated list.
# Linked AFFiNE documents are traversed, but only pages with `publish: true`
# publication metadata are emitted.
AFFINE_MANIFEST_DOC_ID=
AFFINE_PUBLISH_DOC_IDS=
# AFFINE_DOC_MAP_PATH=affine/import-map.en.json

# Optional. The workspace ID is normally inferred from AFFINE_MCP_URL.
AFFINE_WORKSPACE_ID=
AFFINE_LOCALE=en
AFFINE_DISCOVERY_LIMIT=500

# Public editor links shown in the Fumadocs page actions.
NEXT_PUBLIC_AFFINE_BASE_URL=http://localhost:3010
NEXT_PUBLIC_AFFINE_WORKSPACE_ID=

# Default: affine/<locale>
# AFFINE_OUTPUT_ROOT=affine/en
