# Local HTTP endpoint of DAWNCR0W/affine-mcp-server. The managed service creates
# its own loopback-only bridge token in ignored .affine-publisher/bridge.token.
PUBLISHER_SOURCE=bridge
AFFINE_BRIDGE_MCP_URL=http://127.0.0.1:3333/mcp
# Required to copy private AFFiNE attachments into the published site. Use the
# complete Cookie request-header value from a signed-in browser session.
AFFINE_BLOB_COOKIE=
AFFINE_BASE_URL=http://localhost:3010
AFFINE_WORKSPACE_ID=

# The generator switches to bridge discovery/export when these are set.
AFFINE_LOCALE=en
AFFINE_LOCALES_CONFIG=affine/locales.config.json
AFFINE_PUBLISHING_CONFIG=affine/publishing.config.json
# Only used once by pnpm publisher:sync-locales to migrate legacy vaults.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/english-vault
# OBSIDIAN_VAULT_PATH_FR=/absolute/path/to/french-vault
# OBSIDIAN_VAULT_PATH_CN=/absolute/path/to/chinese-vault
PUBLISHER_POLL_SECONDS=45
# Warn if the generated snapshot is older than this during pnpm publisher:doctor.
PUBLISHER_MAX_SNAPSHOT_AGE_SECONDS=900
# Build an immutable static release after each successful AFFiNE refresh.
PUBLISHER_RELEASE_ON_CHANGE=1
PUBLISHER_MULTILINGUAL=1
PUBLISHER_RELEASE_KEEP=3
# Optional absolute pnpm path for service managers with a restricted PATH.
# PUBLISHER_PNPM_BIN=/absolute/path/to/pnpm
# PUBLISHER_RELEASE_ROOT=.affine-publisher/releases
# PUBLISHER_STATE_PATH=.affine-publisher-state.json
