# Local HTTP endpoint of DAWNCR0W/affine-mcp-server. The managed service creates
# its own loopback-only bridge token in ignored .affine-publisher/bridge.token.
PUBLISHER_SOURCE=bridge
AFFINE_BRIDGE_MCP_URL=http://127.0.0.1:3333/mcp
# Required to copy private AFFiNE attachments into the published site. Use the
# complete Cookie request-header value from a signed-in browser session.
AFFINE_BLOB_COOKIE=
AFFINE_BASE_URL=http://localhost:3010
AFFINE_WORKSPACE_ID=

# The generator switches to bridge discovery/export when these are set.
AFFINE_LOCALE=en
AFFINE_LOCALES_CONFIG=affine/locales.config.json
AFFINE_PUBLISHING_CONFIG=affine/publishing.config.json
# Only used once by pnpm publisher:sync-locales to migrate legacy vaults.
# OBSIDIAN_VAULT_PATH=/absolute/path/to/english-vault
# OBSIDIAN_VAULT_PATH_FR=/absolute/path/to/french-vault
# OBSIDIAN_VAULT_PATH_CN=/absolute/path/to/chinese-vault
PUBLISHER_POLL_SECONDS=45
# Warn if the generated snapshot is older than this during pnpm publisher:doctor.
PUBLISHER_MAX_SNAPSHOT_AGE_SECONDS=900
# Build an immutable static release after each successful AFFiNE refresh.
PUBLISHER_RELEASE_ON_CHANGE=1
PUBLISHER_MULTILINGUAL=1
PUBLISHER_RELEASE_KEEP=2
# Coalesce AFFiNE edits before build+deploy (0 = immediate). Default 180.
PUBLISHER_RELEASE_DEBOUNCE_SECONDS=180
# Optional: force which locales Next builds (all | en,fr). Unset = auto from
# .affine-publisher/changed-locales.json after generate:affine:all.
# PUBLISHER_BUILD_LOCALES=all
# Optional: force which locales MCP-export (all | en,fr). Unset = skip locales
# whose published pages still match .affine-publisher/source-revisions.json.
# AFFINE_GENERATE_LOCALES=all
# On a small VPS, skip vitest/oxlint during auto-release (still run doctor + build).
PUBLISHER_RELEASE_SKIP_GATES=1
# Concurrent AFFiNE property/markdown export (bridge mode).
AFFINE_EXPORT_CONCURRENCY=6
PUBLISHER_DEPLOY_TARGET=github-pages
PUBLISHER_DEPLOY_GITHUB_REPO=zubayrali/alkarkari
PUBLISHER_DEPLOY_GITHUB_BRANCH=gh-pages
# Prefer an SSH deploy key on the VPS (no PAT in .env.publisher):
# PUBLISHER_DEPLOY_TARGET=custom
# PUBLISHER_DEPLOY_COMMAND=node scripts/deploy-github-pages-ssh.ts
# PUBLISHER_DEPLOY_SSH_KEY=.affine-publisher/deploy_key
# PUBLISHER_DEPLOY_GITHUB_TOKEN=
# Required for GitHub project Pages (assets must live under /<repo>/<locale>/).
BASE_PATH=/alkarkari
SITE_ORIGIN=https://zubayrali.github.io
# Cloudflare Pages later:
# PUBLISHER_DEPLOY_TARGET=cloudflare-pages
# PUBLISHER_DEPLOY_CF_PROJECT=alkarkari
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Optional absolute pnpm path for service managers with a restricted PATH.
# PUBLISHER_PNPM_BIN=/absolute/path/to/pnpm
# PUBLISHER_RELEASE_ROOT=.affine-publisher/releases
# PUBLISHER_STATE_PATH=.affine-publisher-state.json
