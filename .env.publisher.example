# Local HTTP endpoint of DAWNCR0W/affine-mcp-server. The managed service creates
# its own loopback-only bridge token in ignored .affine-publisher/bridge.token.
PUBLISHER_SOURCE=bridge
AFFINE_BRIDGE_MCP_URL=http://127.0.0.1:3333/mcp
# Required to copy private AFFiNE attachments into the published site. Use the
# complete Cookie request-header value from a signed-in browser session.
AFFINE_BLOB_COOKIE=
AFFINE_BASE_URL=http://localhost:3010
AFFINE_WORKSPACE_ID=

# The generator switches to bridge discovery/export when these are set.
AFFINE_LOCALE=en
PUBLISHER_POLL_SECONDS=45
# Warn if the generated snapshot is older than this during pnpm publisher:doctor.
PUBLISHER_MAX_SNAPSHOT_AGE_SECONDS=900
# PUBLISHER_STATE_PATH=.affine-publisher-state.json
